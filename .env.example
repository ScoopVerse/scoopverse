
# DATABASE_URL: PostgreSQL connection string for users + sessions.
DATABASE_URL="postgres://scoopverse:CHANGE_ME@localhost:5432/scoopverse"

# SESSION_SECRET: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGE_ME"

# PORT: port the Express server listens on (default 3000).
PORT=3000

# NODE_ENV: set to "production" on the server (serves dist/, secure cookies, trusts the proxy).
# NODE_ENV=production

# APP_URL: public URL of the site, used in links inside emails.
APP_URL="http://localhost:3000"

# VERIFY_TOKEN_TTL_SECONDS: how long an email verification link is valid (600 = 10 minutes).
VERIFY_TOKEN_TTL_SECONDS=600

# SMTP: local development uses Mailpit (localhost:1025, no login, inbox at http://localhost:8025).
# On the server, point these at Mailcow (e.g. port 465 with SMTP_SECURE=true, or 587).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ScoopVerse <no-reply@scoopverse.local>"


# EASYPARCEL: from the app made at https://api.easyparcel.com (Developer Hub). Its Redirect URI must be
# APP_URL + /api/easyparcel/callback. An admin then clicks "Connect" on the admin Overview page to link the account
# (Sandbox account = test mode, Live account = real shipments).
EASYPARCEL_CLIENT_ID=""
EASYPARCEL_CLIENT_SECRET=""

# RESET_TOKEN_TTL_SECONDS: how long a password reset link is valid (600 = 10 minutes).
RESET_TOKEN_TTL_SECONDS=600
